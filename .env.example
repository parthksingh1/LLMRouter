# ---------------------------------------------------------------------------
# LLMRouter configuration. Copy to .env; every value below is demo-safe.
# The happy path requires NO real API keys.
#
# Every comment in this file is on its own line, and that is deliberate.
# Docker Compose's env_file parser does not strip a trailing comment from a
# value the way a shell does, so
#
#     MOCK_OPENAI_FAIL_AFTER=      # fail after N requests
#
# sets the variable to the literal string "# fail after N requests". The
# gateway then fails to parse it as an integer and exits at start-up, which
# presents as a container that never becomes ready. Keep comments above the
# line they describe.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
# demo | dev | prod
LLMROUTER_ENV=demo
# debug | info | warn | error
LOG_LEVEL=info
# json | console
LOG_FORMAT=json
GATEWAY_ADDR=:8080
GATEWAY_SHUTDOWN_GRACE_SEC=15
GATEWAY_READ_TIMEOUT_SEC=30
# Long, because SSE streams live here.
GATEWAY_WRITE_TIMEOUT_SEC=120

# --- providers -------------------------------------------------------------
# mock: deterministic fixtures + simulated latency, zero network egress (default)
# live: real upstream calls; requires the API keys below
PROVIDER_MODE=mock
PROVIDERS_CONFIG=/etc/llmrouter/providers.yaml
POLICIES_CONFIG=/etc/llmrouter/policies.yaml
TENANTS_CONFIG=/etc/llmrouter/tenants.yaml

# Only read when PROVIDER_MODE=live. Leave blank for the demo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# --- mock failure injection (powers `make failover-demo`) ------------------
MOCK_SEED=1337
# Fail after N successful requests. Blank means never.
MOCK_OPENAI_FAIL_AFTER=
# Break the SSE stream mid-generation.
MOCK_ANTHROPIC_FAIL_MIDSTREAM=false
# 0.0..1.0, applied to every provider.
MOCK_MIDSTREAM_FAIL_RATE=0.0
# Probability a stream stalls past the timeout.
MOCK_STALL_PROBABILITY=0.0

# --- semantic cache --------------------------------------------------------
CACHE_ENABLED=true
# The operating point from benchmarks/results/cache_calibration.json, chosen
# against a false-hit budget rather than by eye. It is high because a
# bi-encoder scores negation-flipped minimal pairs above many genuine
# paraphrases; see docs/adr/0002-cache-threshold-calibration.md.
CACHE_SIMILARITY_THRESHOLD=0.9962
CACHE_TTL_SEC=86400
CACHE_MAX_PROMPT_CHARS=8000
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=llmrouter_cache
REDIS_URL=redis://redis:6379/0
EMBEDDER_URL=http://embedder:8000
# onnx (all-MiniLM-L6-v2, baked into the image) | hash
EMBEDDER_MODE=onnx
EMBEDDING_DIM=384

# --- guardrails ------------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARDRAILS_URL=http://guardrails:8000
GUARDRAILS_TIMEOUT_MS=50
# open | closed -- see docs/adr/0005-guardrail-sidecar-vs-library.md
GUARDRAILS_FAIL_MODE=open
GUARDRAILS_SCREEN_OUTPUT=false
# Off by default; see README.
GUARDRAILS_TOXICITY_ENABLED=false

# --- budgets ---------------------------------------------------------------
BUDGET_ENABLED=true
BUDGET_WARN_THRESHOLD=0.80
BUDGET_REDIS_URL=redis://redis:6379/1

# --- telemetry -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=llmrouter-gateway
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
METRICS_ADDR=:9090

# --- clickhouse ------------------------------------------------------------
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=llmrouter
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
EVENTS_BATCH_SIZE=500
EVENTS_FLUSH_INTERVAL_MS=2000

# --- dashboard -------------------------------------------------------------
DASHBOARD_PORT=8501
ANOMALY_ZSCORE_THRESHOLD=2.5

# --- seed / benchmarks -----------------------------------------------------
SEED=1337
SEED_DAYS=30
SEED_TARGET_EVENTS=200000
