# ---------------------------------------------------------------------------
# LLMRouter configuration. Copy to .env; every value below is demo-safe.
# The happy path requires NO real API keys.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
LLMROUTER_ENV=demo                  # demo | dev | prod
LOG_LEVEL=info                      # debug | info | warn | error
LOG_FORMAT=json                     # json | console
GATEWAY_ADDR=:8080
GATEWAY_SHUTDOWN_GRACE_SEC=15
GATEWAY_READ_TIMEOUT_SEC=30
GATEWAY_WRITE_TIMEOUT_SEC=120       # long, because SSE streams live here

# --- providers -------------------------------------------------------------
# mock: deterministic fixtures + simulated latency, zero network egress (default)
# live: real upstream calls; requires the API keys below
PROVIDER_MODE=mock
PROVIDERS_CONFIG=/etc/llmrouter/providers.yaml
POLICIES_CONFIG=/etc/llmrouter/policies.yaml
TENANTS_CONFIG=/etc/llmrouter/tenants.yaml

# Only read when PROVIDER_MODE=live. Leave blank for the demo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=

# --- mock failure injection (powers `make failover-demo`) ------------------
MOCK_SEED=1337
MOCK_OPENAI_FAIL_AFTER=              # fail after N successful requests
MOCK_ANTHROPIC_FAIL_MIDSTREAM=false  # break the SSE stream mid-generation
MOCK_MIDSTREAM_FAIL_RATE=0.0         # 0.0..1.0, applied to every provider
MOCK_STALL_PROBABILITY=0.0           # probability a stream stalls past the timeout

# --- semantic cache --------------------------------------------------------
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.9124    # calibrated; see benchmarks/results/cache_calibration.json
CACHE_TTL_SEC=86400
CACHE_MAX_PROMPT_CHARS=8000
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=llmrouter_cache
REDIS_URL=redis://redis:6379/0
EMBEDDER_URL=http://embedder:8000
EMBEDDER_MODE=onnx                   # onnx (all-MiniLM-L6-v2, baked into the image) | hash
EMBEDDING_DIM=384

# --- guardrails ------------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARDRAILS_URL=http://guardrails:8000
GUARDRAILS_TIMEOUT_MS=50
GUARDRAILS_FAIL_MODE=open            # open | closed -- see docs/adr/0005
GUARDRAILS_SCREEN_OUTPUT=false
GUARDRAILS_TOXICITY_ENABLED=false    # off by default; see README

# --- budgets ---------------------------------------------------------------
BUDGET_ENABLED=true
BUDGET_WARN_THRESHOLD=0.80
BUDGET_REDIS_URL=redis://redis:6379/1

# --- telemetry -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=llmrouter-gateway
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
METRICS_ADDR=:9090

# --- clickhouse ------------------------------------------------------------
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=llmrouter
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
EVENTS_BATCH_SIZE=500
EVENTS_FLUSH_INTERVAL_MS=2000

# --- dashboard -------------------------------------------------------------
DASHBOARD_PORT=8501
ANOMALY_ZSCORE_THRESHOLD=2.5

# --- seed / benchmarks -----------------------------------------------------
SEED=1337
SEED_DAYS=30
SEED_TARGET_EVENTS=200000
